; Engine configuration file.
; Core Guardian: Demon Lord's Tower
config_version=5

[application]
config/name="Core Guardian: Demon Lord's Tower"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Defend your 100-floor demon tower in an offline idle tower defense game."
config/version="0.1.0"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.025, 0.055, 1)
